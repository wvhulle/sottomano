vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
    pad: 20
  }
}

direction: right

widget_showcase: sottomano-widget-showcase {
  group_fixtures: "fixtures/*.rs\ngroup(Clock), live(Clock)\nfixed showcase_epoch"
  demo_script: "demo_script::DEMOS\nHover, Press, Drag, RestFor, …"
  showcase_program: "ShowcaseProgram::scripted"
  animation_recording: "animation_recording::record\niced_test emulator, frame clock,\nContentCrop, lavapipe"
  embedding_check: "tour_document_embedding::assert_embedded"
  interactive_tester: "ShowcaseProgram::interactive\n--window"
  ice_scenarios: "tests/ice_scenarios.rs\n.ice scenarios"

  group_fixtures -> demo_script
  demo_script -> showcase_program
  showcase_program -> animation_recording
  group_fixtures -> interactive_tester
  group_fixtures -> ice_scenarios
}

recorded_webp: "recordings/<name>.webp" {shape: page}
showcase_document: "docs/showcase.md\nmust embed every recording" {shape: document}
readme_document: "README.md\nchecks the recordings it embeds" {shape: document}

widget_showcase.animation_recording -> recorded_webp: "lossless animated webp"
widget_showcase.animation_recording -> widget_showcase.embedding_check: "name, width"
widget_showcase.embedding_check -> showcase_document: "<img src width>"
widget_showcase.embedding_check -> readme_document: "<img src width>"
