vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
    pad: 20
  }
}

direction: down

config_crate: sottomano-config {
  config_file: '$XDG_CONFIG_HOME/sottomano.toml' {shape: page}
  config_loading: "ConfigFile::load"
  config_file -> config_loading
}

sources_crate: sottomano-sources {
  grid-columns: 3
  desktop_bus: "D-Bus (zbus)\npower, login session, media, …"
  notification_server: "freedesktop\nnotification server"
  niri_event_thread: "niri IPC\nevent thread"
  wayland_outputs: "Wayland outputs"
  file_watches: "inotify\nconfig file, desktop entries"
  reading_sources: "ReadingSource::\ndelivery_stream"
}

widgets_crate: sottomano-widgets {
  source_subscription: "background_work::source_subscription"
  shell_message: "Message (shell_message.rs)"
}

shell_crate: sottomano-shell {
  run_shell: "run_shell"
  message_subscriptions: "message_subscriptions::subscription"
  shell_update: "DesktopShell::update"
  shell_view: "DesktopShell::view"
  layer_surfaces: "layer-shell surfaces\nbars, panel, sidebar, toasts, tooltips"

  run_shell -> shell_update: "startup load tasks"
  message_subscriptions -> shell_update
  shell_update -> shell_view: "state"
  shell_view -> layer_surfaces
}

state_crate: sottomano-state {
  saved_state_modules: "dark_mode, launches, idle,\nfocus_spans, niri_rules, …"
}

sqlite_state_store: |md
  `$XDG_STATE_HOME/sottomano/state.db`

  via sottomano-sources `sqlite_state_store`
| {shape: cylinder}

state_crate.saved_state_modules <-> sqlite_state_store

config_crate.config_loading -> shell_crate.run_shell
sources_crate -> shell_crate.message_subscriptions: "ConfigFileChanged, Niri, DesktopBus, …"
sources_crate.reading_sources -> widgets_crate.source_subscription: "SourceDelivery"
widgets_crate.source_subscription -> widgets_crate.shell_message
widgets_crate.shell_message -> shell_crate.message_subscriptions
shell_crate.shell_update <-> state_crate.saved_state_modules: "restore / persist"
