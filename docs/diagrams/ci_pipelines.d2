vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
    pad: 20
  }
}

direction: right

pull_request_event: "pull request" {shape: oval}
main_push_event: "push or manual on main" {shape: oval}

checks_pipeline: ".woodpecker/checks.yaml" {
  cargo_checks_pr: "cargo-checks-pr\ntests, clippy"
  cargo_checks: "cargo-checks\ntests, clippy via cachix"
  format_check: "format\ntreefmt: rustfmt, nixfmt, d2 fmt"
  diagrams_check: "d2-diagrams\nrendered SVGs up to date"
  conventional_commits: "conventional-commits\nconvco check FETCH_HEAD..HEAD"
}

recordings_pipeline: ".woodpecker/readme-recordings.yaml\nskips recordings/** and its own commits" {
  render_recordings: "render-readme-recordings\nnix build .#readme-recordings"
  push_recordings_branch: "push-readme-recordings-branch\nforce-push to Codeberg"
  open_recordings_pull_request: "open-readme-recordings-pr\nopen, update or close"

  render_recordings -> push_recordings_branch: "cp result/*.webp recordings/"
  push_recordings_branch -> open_recordings_pull_request
}

main_branch: "main" {shape: cylinder}

pull_request_event -> checks_pipeline.cargo_checks_pr
pull_request_event -> checks_pipeline.format_check
pull_request_event -> checks_pipeline.conventional_commits
pull_request_event -> checks_pipeline.diagrams_check
main_push_event -> checks_pipeline.cargo_checks
main_push_event -> checks_pipeline.format_check
main_push_event -> checks_pipeline.diagrams_check
checks_pipeline -> recordings_pipeline: "depends_on: checks"
recordings_pipeline.open_recordings_pull_request -> main_branch: "readme-recordings PR"
